{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "job-queue-system-notification-{0:yyyy.MM.dd}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "SYNCFUSION_LICENSE_KEY": "[REPLACE_ME]",
  "ApplicationSettings": {
    "JobRepositoryClientConfig": {
      "BaseUrl": "http://localhost:8001",
      "AuthClientCredentials": {
        "ClientId": "[REPLACE_ME]",
        "ClientSecret": "[REPLACE_ME]",
        "Authority": "http://localhost:8080",
        "Realm": "JobQueueSystemRealm"
      }
    },
    "RabbitConfig": {
      "User": "guest",
      "Password": "guest",
      "Host": "rabbitmq://localhost"
    }
  }
}
