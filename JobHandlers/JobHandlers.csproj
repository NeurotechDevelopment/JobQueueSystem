<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-JobHandlers-59867ab9-8f41-4954-9b73-d07b75417fa2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Syncfusion.DocIO.Net.Core" Version="29.1.40" />
    <PackageReference Include="Syncfusion.DocIORenderer.Net.Core" Version="29.1.40" />
    <PackageReference Include="Syncfusion.HtmlToPdfConverter.Net.Windows" Version="29.1.40" />
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="29.1.40" />
    <PackageReference Include="Syncfusion.PDF.OCR.Net.Core" Version="29.1.40" />
    <PackageReference Include="Syncfusion.XlsIO.Net.Core" Version="29.1.40" />
    <PackageReference Include="Syncfusion.XlsIORenderer.Net.Core" Version="29.1.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tessdata\**\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes\tessdata\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
</Project>
