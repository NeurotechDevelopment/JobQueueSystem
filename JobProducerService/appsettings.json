{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Trace"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://localhost:9200",
          "indexFormat": "job-queue-system-notification-{0:yyyy.MM.dd}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "RabbitConfig": {
      "QueueName": "job-request-queue",
      "User": "guest",
      "Password": "guest",
      "Host": "rabbitmq://localhost"
    },
    "JobRepositoryClientConfig": {
      "BaseUrl": "https://localhost:7089",
      "AuthClientCredentials": {
        "ClientId": "[REPLACE-ME]",
        "ClientSecret": "[REPLACE-ME]",
        "Authority": "http://localhost:8080",
        "Realm": "JobQueueSystemRealm"
      }
    },
    "AuthOptions": {
      "Authority": "http://localhost:8080",
      "Audiences": [ "[REPLACE-ME]" ],
      "Realm": "JobQueueSystemRealm"
    }
  }
}
